{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "promptLab",
  "version": "1.0.0",
  "identifier": "fun.zhecheng.promptlab",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "promptLab",
        "url": "https://skills.zhecheng.fun",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
